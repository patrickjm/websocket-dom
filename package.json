{
  "name": "syncui-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && node scripts/lint-custom.mjs",
    "e2e": "turbo run e2e --output-logs=full --log-prefix=none --log-order=grouped",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.27.1",
    "turbo": "^2.0.0"
  }
}
