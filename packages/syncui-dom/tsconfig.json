{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ES2015",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "downlevelIteration": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "syncui": ["../syncui/dist/index.d.ts"],
      "syncui/client": ["../syncui/dist/client/index.d.ts"],
      "syncui/client/*": ["../syncui/dist/client/*"],
      "syncui/shared-utils": ["../syncui/dist/shared-utils.d.ts"],
      "syncui/*": ["../syncui/dist/*"]
    },
    "declarationMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "dist"]
}
