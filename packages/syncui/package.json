{
  "name": "syncui",
  "module": "src/index.ts",
  "type": "module",
  "version": "0.3.0",
  "description": "Experimental 2-way sync between backend JSDOM and frontend DOM using WebSockets",
  "repository": "https://github.com/patrickjm/syncui",
  "author": "Patrick Moriarty <patrick@moriarty.dev>",
  "keywords": [
    "websocket",
    "dom",
    "jsdom",
    "sync",
    "realtime"
  ],
  "files": [
    "README.md",
    "src",
    "dist"
  ],
  "scripts": {
    "build:client": "vite build",
    "build:server": "bun build src/index.ts --outdir dist --target node --format esm --sourcemap=inline -e jsdom",
    "build:types": "tsc",
    "build:e2e": "vite build -c e2e/vite.config.ts",
    "clean": "touch ./dist && rm -r ./dist",
    "build": "yarn clean && yarn build:types && yarn build:server && yarn build:client",
    "e2e": "playwright test",
    "e2e:server": "node --import tsx e2e/setup/start-server.ts",
    "start": "vite build && tsx ./src/index.ts",
    "dev": "nodemon --watch src --watch vite.config.ts --watch index.html --watch public --ext ts,html,json,tsx --exec yarn start"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client/index.d.ts"
    },
    "./shared-utils": {
      "import": "./dist/shared-utils.js",
      "types": "./dist/shared-utils.d.ts"
    },
    "./core/adapter/types": {
      "import": "./dist/core/adapter/types.js",
      "types": "./dist/core/adapter/types.d.ts"
    },
    "./core/model/nodes": {
      "import": "./dist/core/model/nodes.js",
      "types": "./dist/core/model/nodes.d.ts"
    },
    "./core/model/xpath": {
      "import": "./dist/core/model/xpath.js",
      "types": "./dist/core/model/xpath.d.ts"
    },
    "./core/ops/instructions": {
      "import": "./dist/core/ops/instructions.js",
      "types": "./dist/core/ops/instructions.d.ts"
    },
    "./core/protocol/events": {
      "import": "./dist/core/protocol/events.js",
      "types": "./dist/core/protocol/events.d.ts"
    },
    "./core/protocol/messages": {
      "import": "./dist/core/protocol/messages.js",
      "types": "./dist/core/protocol/messages.d.ts"
    },
    "./core/transport/types": {
      "import": "./dist/core/transport/types.js",
      "types": "./dist/core/transport/types.d.ts"
    }
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.5.4",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "nodemon": "^3.1.4",
    "syncui-dom": "^0.0.1",
    "tsx": "^4.19.0",
    "typed-emitter": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "vite": "^5.4.3",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
