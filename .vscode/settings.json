{
  // Exclude the dist folder from Quick Open (Cmd+P) but keep it in the file tree
  "search.exclude": {
    "dist": true,
    "node_modules": true,
    "playwright-report": true,
    "test-results": true,
    "e2e/dist": true,
    "packages/*/dist": true,
    "packages/*/playwright-report": true,
    "packages/*/test-results": true,
    "packages/*/e2e/dist": true
  },
  "files.exclude": {
    "dist": false,
    "node_modules": true,
    "playwright-report": true,
    "test-results": true,
    "packages/*/playwright-report": true,
    "packages/*/test-results": true
  },
  "files.watcherExclude": {
    "dist/**": true,
    "node_modules/**": true,
    "playwright-report/**": true,
    "test-results/**": true,
    "e2e/dist/**": true,
    "packages/*/dist/**": true,
    "packages/*/playwright-report/**": true,
    "packages/*/test-results/**": true,
    "packages/*/e2e/dist/**": true
  }
}
